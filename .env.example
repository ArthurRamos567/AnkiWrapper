# ============================================================
# AnkiWrapper — Exemplo de Configurações de Ambiente
# Copie este arquivo para .env e preencha conforme necessário
# ============================================================

# Chave de API do Google Gemini (Google AI Studio)
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=

# Modelo da Gemini API (Google AI Studio)
GEMINI_MODEL=gemini-3.5-flash-lite

# Modelo do AGY CLI (caso execute nativamente com agy local)
AGY_MODEL=gemini-3.8-flash-low

# Provedor LLM: 'auto' (padrão), 'gemini' ou 'agy'
LLM_PROVIDER=auto

# Porta do Servidor Web HTTP
PORT=8080

# Caminho do banco SQLite do Anki (collection.anki2)
# Deixe em branco para detecção automática (Flatpak / Linux / Windows / Mac)
# ANKI_COLLECTION_PATH=/home/seu-usuario/.var/app/net.ankiweb.Anki/data/Anki2/User 1/collection.anki2
# ANKI_PATH=

# Caminho do banco SQLite local da aplicação
DB_PATH=data/app.db
